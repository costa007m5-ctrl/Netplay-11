# ============================================================
# NetPlay — Variáveis de Ambiente para Vercel
# Copie este arquivo para .env.local para desenvolvimento local
# Configure no painel Vercel em Settings > Environment Variables
# ============================================================

# TMDB (The Movie Database) — obrigatório
# Crie sua chave em: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=

# Supabase — obrigatório (auth e banco de dados)
# Encontre em: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Firebase — obrigatório (auth e firestore)
# Encontre em: https://console.firebase.google.com/project/_/settings/general
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Gemini AI — opcional (tradução automática de sinopses)
# Crie sua chave em: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Terabox Pro API — opcional (função serverless /api/terabox-pro)
# Usada pela API serverless — NÃO precisa do prefixo VITE_
TERABOX_PRO_API_KEY=

# OneSignal — opcional (notificações push)
# Encontre em: https://app.onesignal.com
VITE_ONESIGNAL_APP_ID=
